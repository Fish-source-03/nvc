        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            PDF 表格结构化提取（批次 06 · 任务 6.1.1，问题 10）。

            决策走 tabula-java（方案文档 doc/未来补充/PDF带表格的结构保留切片方案.md:55），
            不使用 Apache Tika：Tika 底层同样是 PDFBox，优势在格式检测与元数据，
            表格检测能力弱；原先引入的 tika-parsers-standard-package:2.9.2 全仓零引用
            （死依赖），已在本批次移除。

            兼容性：tabula 1.0.5 编译期声明 PDFBox 2.0.24，本模块直接声明 3.0.3（就近原则），
            依赖调解后 classpath 上只有 PDFBox 3.0.3；已实测 ObjectExtractor +
            SpreadsheetExtractionAlgorithm 在 PDFBox 3.0.3 运行时可用（见 progress.md §4.7）。

            ⚠️ 唯一的排除项 slf4j-simple：tabula 自带 `org.slf4j:slf4j-simple`（其 CLI 用的
            slf4j 实现），与 Spring Boot 的 logback 形成"双 provider"。SLF4J 按 ServiceLoader
            顺序择一绑定，实测在 agent-qr-compensation 模块下会绑定到 slf4j-simple，
            使 `(Logger) LoggerFactory.getLogger(...)` 抛 ClassCastException
            （DocumentDeleteServiceV2Test 11 个用例报错）。排除后日志实现统一为 logback。
            （slf4j-api 经调解已是 2.0.18，无需处理。）
        -->
        <dependency>
            <groupId>technology.tabula</groupId>
            <artifactId>tabula</artifactId>
            <version>1.0.5</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>


</project>
